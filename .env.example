# ============================
# App
# ============================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-here

# ============================
# Google OAuth
# (Get from console.cloud.google.com → APIs & Services → Credentials)
# ============================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================
# Supabase
# (Get from supabase.com → Project Settings → API)
# ============================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database URL for Prisma (use Transaction Pooler from Supabase)
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

# ============================
# OpenAI (or use Groq for free)
# ============================
OPENAI_API_KEY=sk-your-openai-api-key

# ============================
# Groq (FREE alternative to OpenAI — 14,400 req/day free)
# (Get from console.groq.com)
# ============================
# GROQ_API_KEY=gsk_your-groq-api-key

# ============================
# Cron Security (for /api/schedule/tick)
# Generate a random secret: openssl rand -hex 32
# ============================
CRON_SECRET=your-random-cron-secret

# ============================
# App Config
# ============================
AGENT_CONFIDENCE_THRESHOLD=0.75
AGENT_BATCH_SIZE=50
CACHE_EXPIRY_DAYS=30
